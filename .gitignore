# Unreal Engine generated files
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Build output (keep project icons and packaging blacklist files)
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Generated files inside plugins
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/DerivedDataCache/
Plugins/**/Saved/

# Visual Studio
.vs/
*.VC.db
*.VC.opendb
*.sdf
*.sln
*.suo
*.opensdf
*.opendb
*.VC.VC.opendb
*.csproj
*.csproj.user
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.user
*.sln.docstates

# JetBrains Rider
.idea/
.idea.*
*.sln.iml

# Visual Studio Code
.vscode/

# Xcode
*.xcworkspace
*.xcuserdatad
*.xcuserdata
*.xcodeproj

# Unreal Engine crash and log files
crashinfo--*
*.log

# Automation and local test output
TestResults/
AutomationReports/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and backup files
*.bak
*.tmp
*.temp
*~

# Large third-party sample content kept locally only.
# ParagonTwinblast is 2.4 GB of Epic sample assets; committing it would
# bloat the repository far past what GitHub is meant to carry.
Content/ParagonTwinblast/

# Downloaded asset packs, kept locally only for the same reason: together
# these are roughly 4.5 GB, and every one of them can be fetched again from
# where it came from (Epic's free library, Fab, KitBash3D).
#
# The trade-off: a fresh clone opens the level with broken references, because
# 104 tracked assets point into Content/cyberdistrict. Re-import the packs
# before opening Lvl_NeonDistrict. Anything built on top of them -- the
# material instances, the level actors, the blueprints -- stays in the
# repository, so only the source meshes and textures need fetching.
Content/ParagonLtBelica/
Content/cyberdistrict/
Content/Pack_Bonus/
Content/NeonGrid/
Content/EasyFog/
Content/Fab/
Content/SystemFonts/

# Local study imports and their notes. Not part of the project's deliverable
# resources; kept out of the repository entirely (roadmap item 11).
Content/CP77_Study/
docs/CP77_Study/
SourceArt/
Tools/

# Imported props and their source textures (187 MB, and a single 4K texture in
# here outweighs every level actor put together). Unlike the packs above these
# were brought in and wired up by hand, so keep the local copy: the level
# references them and a fresh clone will show those props missing.
Content/MyAssets/

# Downloaded archives that got unpacked into Content. The assets inside are
# committed on their own; the zip is just the delivery wrapper.
Content/**/*.zip
Content/**/*.rar
Content/**/*.7z

# Substance source files and their raw exports (231 MB). The textures that
# matter are already imported under Content/MyAssets; these are the editable
# originals and belong with SourceArt/ rather than in the repository.
#
# Anchored: an unanchored "Assets/" matches that folder name at any depth, and
# it was quietly catching Content/LevelPrototyping/.../JumpPad/Assets as well.
/Assets/
